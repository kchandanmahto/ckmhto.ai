# =========================================================
# CHANDAN PORTFOLIO — ENVIRONMENT CONFIGURATION
# =========================================================
#
# This file contains example environment variables only.
# NEVER put real API keys, passwords or production secrets here.
#
# Copy the required variables into the appropriate local
# environment files:
#
# Backend  -> backend/.env
# Frontend -> frontend/.env.local
#
# =========================================================


# =========================================================
# DATABASE
# =========================================================

# PostgreSQL / Neon connection string.
#
# Example:
# postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE
#
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE


# =========================================================
# AI / GROQ
# =========================================================

# Groq API key.
#
# Get your own key from the Groq platform.
# Never commit the real key to Git.
#
GROQ_API_KEY=your_groq_api_key_here


# Groq model used by the backend.
#
# Use a model currently available in your Groq account.
#
GROQ_MODEL=your_groq_model_here


# =========================================================
# BACKEND
# =========================================================

# Application environment.
#
# Possible values:
# development
# production
#
APP_ENV=development


# Backend server host.
#
HOST=127.0.0.1


# Backend server port.
#
PORT=8000


# =========================================================
# CORS
# =========================================================

# Frontend origin allowed to communicate with the backend.
#
# Local development:
#
FRONTEND_URL=http://localhost:3000
#
# Production example:
#
# FRONTEND_URL=https://ckmhto.ai
#
FRONTEND_URL=http://localhost:3000


# =========================================================
# FRONTEND
# =========================================================

# Backend API base URL used by the frontend.
#
# Local development:
#
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Production example:
#
# NEXT_PUBLIC_API_URL=https://api.ckmhto.ai
#
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000


# =========================================================
# OPTIONAL
# =========================================================

# Application log level.
#
LOG_LEVEL=INFO